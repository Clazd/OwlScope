AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL_STRONG=
AI_MODEL_FAST=
AI_BASE_URL=

# Optional Radar credentials. Every feed still works without them.
# A GitHub fine-grained personal access token raises API rate limits.
GITHUB_TOKEN=
# Reddit "script" app credentials enable OAuth instead of anonymous feeds.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=PersonaStudio-Radar/0.1 by your-reddit-username

SANDBOX_MODE=false
