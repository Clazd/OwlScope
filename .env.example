AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL_STRONG=
AI_MODEL_FAST=
# Leave empty for https://api.anthropic.com. DeepSeek's Anthropic-compatible
# endpoint is also supported when paired with compatible model names.
AI_BASE_URL=

# Optional Radar credentials. Every feed still works without them.
# A GitHub fine-grained personal access token raises API rate limits.
GITHUB_TOKEN=
# Reddit "script" app credentials enable OAuth instead of anonymous feeds.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=GroundedVoice-Radar/0.1 by your-reddit-username

SANDBOX_MODE=false

# Advanced local paths and diagnostics. Relative paths are resolved from the
# repository root. Leave empty for ./data, ./fixtures, and the default log level.
DATA_DIR=
FIXTURES_DIR=
LOG_LEVEL=

# Disabled by default because data contains private identity and writing history.
# Enable only when this checkout and its remote are private.
GIT_SYNC_DATA=false
